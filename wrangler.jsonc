{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ming-site",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": false,
  },
}
