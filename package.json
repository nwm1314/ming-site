{
  "name": "ming-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "pnpm": ">=11.19.0 <12.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "deploy": "pnpm build && pnpm exec wrangler deploy",
    "cf:preview": "pnpm build && pnpm exec wrangler dev",
    "cf:dry-run": "pnpm build && pnpm exec wrangler deploy --dry-run",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "pnpm test:cms && pnpm test:content && pnpm test:scaffold && pnpm test:unit && pnpm test:e2e",
    "test:cms": "node scripts/validate-cms-config.mjs",
    "test:content": "node scripts/validate-content.mjs",
    "test:scaffold": "node scripts/test-new-content.mjs",
    "test:links": "node scripts/check-internal-links.mjs",
    "test:media": "node scripts/check-media.mjs",
    "test:unit": "playwright test tests/unit --config=playwright.unit.config.ts",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:ui": "playwright test tests/e2e --ui",
    "test:privacy": "node scripts/privacy-smoke.mjs",
    "test:cf": "node scripts/test-cloudflare-routing.mjs",
    "test:release": "node scripts/release-smoke.mjs",
    "new:post": "node scripts/new-content.mjs post",
    "new:moment": "node scripts/new-content.mjs moment"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "4.129.0",
    "yaml": "2.9.0"
  }
}
