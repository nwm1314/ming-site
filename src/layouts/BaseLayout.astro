---
import { site } from '../config/site';
import { getProfile } from '../lib/content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  canonical?: string | URL;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = site.defaults.ogImage,
  imageAlt,
  ogType = 'website',
  noindex = false,
  canonical,
  articlePublishedTime,
  articleModifiedTime,
  jsonLd,
} = Astro.props;

const profile = await getProfile();
const resolvedTitle = title ?? profile.data.seo.title;
const resolvedDescription = description ?? profile.data.seo.description;
const resolvedImageAlt = imageAlt ?? resolvedTitle;

const shouldNoindex = noindex || !site.indexable;
const canonicalUrl = (canonical ?? new URL(Astro.url.pathname, site.siteUrl)).toString();
const imageUrl = new URL(image, site.siteUrl).toString();
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.siteUrl}#person`,
  name: profile.data.displayName,
  url: site.siteUrl,
};
const structuredData = [personJsonLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="zh-CN" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={resolvedDescription} />
    <meta name="application-name" content={profile.data.displayName} />
    <meta name="theme-color" content="#d7f36b" />
    {shouldNoindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.data.displayName} RSS`} href={`${site.siteUrl}/rss.xml`} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.data.displayName} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={resolvedImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={resolvedImageAlt} />
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    <title>{resolvedTitle}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('ming-theme');
        const theme = stored === 'light' || stored === 'dark' ? stored : 'system';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {structuredData.map((entry) => <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <slot />
    </div>
  </body>
</html>
