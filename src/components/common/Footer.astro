---
import { exploreLinks } from '../../config/navigation';
import { getProfile } from '../../lib/content';

const profile = await getProfile();
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="footer-top">
    <div>
      <p class="eyebrow">keep a tab open</p>
      <h2>还有东西在路上。</h2>
    </div>
    <p class="footer-note">一个轻量、诚实、慢慢更新的个人角落。<br />下次见，希望这里又多了一点新东西。</p>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} {profile.data.displayName}</span>
    <nav aria-label="Footer navigation">
      {exploreLinks.slice(0, 4).map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="footer-socials">
      {profile.data.contacts.github && <a href={profile.data.contacts.github} target="_blank" rel="noopener noreferrer">GH</a>}
      {profile.data.contacts.email && <a href={`mailto:${profile.data.contacts.email}`}>Mail</a>}
    </div>
  </div>
</footer>
