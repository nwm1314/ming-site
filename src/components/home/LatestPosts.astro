---
import { formatDate, getPublicPosts, readingTime } from '../../lib/content';

const posts = (await getPublicPosts()).slice(0, 4);
---

<section class="posts-section section-pad" id="blog">
  <div class="section-heading section-heading-row reveal-up">
    <div><p class="eyebrow">/ from the notebook</p><h2>最近写了，<em>一些东西</em>。</h2></div>
    <a class="text-link hide-mobile" href="/blog">进入 Blog <span aria-hidden="true">↗</span></a>
  </div>

  {posts.length > 0 ? (
    <div class="post-list reveal-up" style="--delay: 100ms">
      {posts.map((post, index) => (
        <a class="post-row" href={`/blog/${post.id}`}>
          <span class="post-index">{String(index + 1).padStart(2, '0')}</span>
          <span class="post-category">{post.data.category}</span>
          <span class="post-title">{post.data.title}</span>
          <span class="post-description">{post.data.description}</span>
          <span class="post-date">{formatDate(post.data.publishDate, { month: 'short', day: '2-digit' })} · {readingTime(post.body ?? '')} min</span>
          <span class="post-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  ) : (
    <div class="empty-state">目前没有公开文章。</div>
  )}
</section>
