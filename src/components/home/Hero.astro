---
import { getProfile } from '../../lib/content';

const profile = await getProfile();
---

<section class="hero section-pad">
  <div class="hero-grid-mark" aria-hidden="true"></div>
  <div class="hero-copy reveal-up">
    <p class="eyebrow hero-eyebrow"><span class="eyebrow-line"></span>personal digital space · 01</p>
    <h1>{profile.data.displayName}<span class="hero-punctuation">.</span></h1>
    <p class="hero-role">{profile.data.tagline}</p>
    <p class="hero-bio">{profile.data.bio}</p>
    <div class="hero-links">
      <a class="button button-primary" href="/projects">看看我在做什么 <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="/about">关于我 <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="hero-portrait reveal-up" style="--delay: 120ms">
    <div class="avatar-card">
      <div class="avatar-orbit avatar-orbit-one"></div>
      <div class="avatar-orbit avatar-orbit-two"></div>
      {profile.data.avatar.src ? <img src={profile.data.avatar.src} alt={profile.data.avatar.alt} width={profile.data.avatar.width} height={profile.data.avatar.height} /> : <span class="avatar-placeholder">{profile.data.avatar.fallback}</span>}
    </div>
    <div class="hero-sticker">✦<br /><span>stay curious</span></div>
    <div class="hero-status"><span class="status-dot"></span>{profile.data.status}</div>
  </div>

  <div class="hero-meta reveal-up" style="--delay: 240ms">
    <span>scroll to explore</span>
    <span class="scroll-arrow" aria-hidden="true">↓</span>
  </div>
</section>
