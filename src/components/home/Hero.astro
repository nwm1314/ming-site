---
import { site } from '../../config/site';
---

<section class="hero section-pad">
  <div class="hero-grid-mark" aria-hidden="true"></div>
  <div class="hero-copy reveal-up">
    <p class="eyebrow hero-eyebrow"><span class="eyebrow-line"></span>{site.hero.eyebrow}</p>
    <h1>{site.hero.name}<span class="hero-punctuation">.</span></h1>
    <p class="hero-role">{site.hero.role}</p>
    <p class="hero-bio">{site.hero.bio}</p>
    <div class="hero-links">
      <a class="button button-primary" href="/projects">看看我在做什么 <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="/about">关于我 <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="hero-portrait reveal-up" style="--delay: 120ms">
    <div class="avatar-card" role="img" aria-label={site.avatar.alt}>
      <div class="avatar-orbit avatar-orbit-one"></div>
      <div class="avatar-orbit avatar-orbit-two"></div>
      {site.avatar.src ? <img src={site.avatar.src} alt={site.avatar.alt} /> : <span class="avatar-placeholder">{site.avatar.fallback}</span>}
    </div>
    <div class="hero-sticker">✦<br /><span>stay curious</span></div>
    <div class="hero-status"><span class="status-dot"></span>{site.hero.status}</div>
  </div>

  <div class="hero-meta reveal-up" style="--delay: 240ms">
    <span>scroll to explore</span>
    <span class="scroll-arrow" aria-hidden="true">↓</span>
  </div>
</section>
