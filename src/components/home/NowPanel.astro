---
import { formatDotDate, getCurrentNow } from '../../lib/content';

const now = await getCurrentNow();
const nowItems = [now.data.building, now.data.exploring, now.data.learning];
---

<section class="now-section section-pad" id="now">
  <div class="section-heading reveal-up">
    <p class="eyebrow">/ now</p>
    <h2>这段时间，<em>正在发生</em>。</h2>
    <p>不是履历，是此刻打开的几个 tab。</p>
  </div>

  <div class="now-board reveal-up" style="--delay: 100ms">
    <div class="now-board-top">
      <span class="board-label">CURRENT STATUS</span>
      <span class="board-date">updated {formatDotDate(now.data.updatedAt)}</span>
    </div>
    <div class="now-items">
      {nowItems.map((item, index) => (
        <div class:list={{ 'now-item': true, 'now-item-main': index === 0 }}>
          <span class="now-index">{String(index + 1).padStart(2, '0')}</span>
          <div><span class="now-kicker">{item.label}</span><strong>{item.text}</strong></div>
          {index === 0 && <span class="now-scribble" aria-hidden="true">✎</span>}
        </div>
      ))}
    </div>
  </div>
</section>
