---
import Header from '../../../components/common/Header.astro';
import Footer from '../../../components/common/Footer.astro';
import PostList from '../../../components/blog/PostList.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../config/site';
import { getPostsForTaxonomy, getPublicPosts, getTaxonomyTerms } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublicPosts();
  return getTaxonomyTerms(posts, 'tag').map((term) => ({
    params: { tag: term.slug },
    props: { term, posts: getPostsForTaxonomy(posts, 'tag', term.slug) },
  }));
}

const { term, posts } = Astro.props;
---

<BaseLayout
  title={`#${term.displayName} — Tags — Ming`}
  description={`浏览标签 ${term.displayName} 下的 ${posts.length} 篇公开文章。`}
  canonical={`${site.siteUrl}/blog/tag/${encodeURIComponent(term.slug)}`}
>
  <Header />
  <main id="main-content" class="content-page">
    <div class="page-intro"><p class="eyebrow">/ tag</p><h1>#{term.displayName}<span class="hero-punctuation">.</span></h1><p>{posts.length} 篇公开文章，按发布时间倒序排列。</p></div>
    <PostList posts={posts} />
  </main>
  <Footer />
</BaseLayout>
