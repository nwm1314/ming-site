---
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search — Ming" description="搜索 Ming 的公开文章。" noindex>
  <Header />
  <main id="main-content" class="content-page search-page" data-pagefind-ignore>
    <div class="page-intro"><p class="eyebrow">/ search the notebook</p><h1>Search<span class="hero-punctuation">.</span></h1><p>在公开文章中寻找关键词、工具名或一个还记得的句子。</p></div>
    <form class="search-form" data-search-form role="search" action="/search" method="get">
      <label for="search-input">Search posts</label>
      <div class="search-input-row">
        <input id="search-input" name="q" type="search" placeholder="Try Astro, 网络，或者工作流" autocomplete="off" autofocus />
        <button class="button button-primary" type="submit">Search <span aria-hidden="true">↗</span></button>
      </div>
    </form>
    <p class="search-status" data-search-status aria-live="polite">输入关键词开始搜索。</p>
    <div class="search-results" id="search-results" data-search-results aria-live="polite"></div>
  </main>
  <Footer />
</BaseLayout>

<script>
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta?: { title?: string };
  }

  interface PagefindResult {
    data: () => Promise<PagefindResultData>;
  }

  interface PagefindApi {
    search: (term: string) => Promise<{ results: PagefindResult[] }>;
  }

  const form = document.querySelector<HTMLFormElement>('[data-search-form]');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const results = document.querySelector<HTMLElement>('[data-search-results]');
  let pagefind: PagefindApi | undefined;

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  function setLoading(isLoading: boolean) {
    if (results) results.setAttribute('aria-busy', String(isLoading));
  }

  async function loadPagefind() {
    if (pagefind) return pagefind;
    // Pagefind is generated into dist after Astro builds the site.
    // Keep the runtime import untouched so Vite does not try to bundle a generated public module.
    const loadGeneratedModule = new Function('path', 'return import(path)') as (path: string) => Promise<PagefindApi>;
    pagefind = await loadGeneratedModule('/pagefind/pagefind.js');
    return pagefind;
  }

  async function runSearch(term: string) {
    const query = term.trim();
    if (!results) return;
    results.replaceChildren();
    setLoading(false);
    if (!query) {
      setStatus('输入关键词开始搜索。');
      return;
    }

    setStatus('正在翻开笔记……');
    setLoading(true);
    try {
      const search = await loadPagefind();
      const response = await search.search(query);
      const resultData = await Promise.all(response.results.slice(0, 12).map((result) => result.data()));

      if (resultData.length === 0) {
        setStatus(`没有找到与“${query}”相关的文章。`);
        return;
      }

      setStatus(`找到 ${resultData.length} 篇相关结果。`);
      for (const result of resultData) {
        const link = document.createElement('a');
        link.className = 'search-result';
        link.href = result.url;

        const title = document.createElement('strong');
        title.textContent = result.meta?.title ?? result.url;
        const excerpt = document.createElement('span');
        // Pagefind documents excerpt as entity-encoded HTML with controlled <mark> tags.
        excerpt.innerHTML = result.excerpt;
        link.append(title, excerpt);
        results.append(link);
      }
    } catch {
      setStatus('搜索索引暂时不可用，但网站其他内容仍可正常浏览。');
    } finally {
      setLoading(false);
    }
  }

  const initialQuery = new URLSearchParams(window.location.search).get('q') ?? '';
  if (input && initialQuery) input.value = initialQuery;
  if (initialQuery) void runSearch(initialQuery);

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input?.value ?? '';
    const url = new URL(window.location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    window.history.replaceState({}, '', url);
    void runSearch(query);
  });
</script>
