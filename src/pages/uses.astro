---
import { getCollection } from 'astro:content';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const uses = (await getCollection('uses')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Uses — Ming" description="Ming 的数字工作台：设备、软件与工作流。"><Header /><main id="main-content" class="content-page"><div class="page-intro"><p class="eyebrow">/ digital desk</p><h1>Uses<span class="hero-punctuation">.</span></h1><p>没有百分比，只有我反复打开的东西。</p></div><div class="uses-list">{uses.map((use) => <div class="use-row"><span class="desk-icon">{use.data.icon}</span><div><span class="desk-category">{use.data.category}</span><h2>{use.data.name}</h2><p>{use.data.description}</p></div>{use.data.url && <a class="text-link" href={use.data.url} target="_blank" rel="noopener noreferrer">visit ↗</a>}</div>)}</div></main><Footer /></BaseLayout>
