---
import { getCollection, render } from 'astro:content';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} — Ming`} description={project.data.summary}>
  <Header /><main id="main-content" class="article-page"><article><header class="article-header"><a class="back-link" href="/projects">← all projects</a><p class="eyebrow">{project.data.statusLabel ?? project.data.status} · {project.data.stack.join(' · ')}</p><h1>{project.data.title}</h1><p class="article-lede">{project.data.summary}</p><div class="article-actions">{project.data.repo && <a class="button button-primary" href={project.data.repo} target="_blank" rel="noreferrer">Source ↗</a>}{project.data.demo && <a class="text-link" href={project.data.demo} target="_blank" rel="noreferrer">Live Demo ↗</a>}</div></header><div class="article-body prose"><Content /></div></article></main><Footer />
</BaseLayout>
